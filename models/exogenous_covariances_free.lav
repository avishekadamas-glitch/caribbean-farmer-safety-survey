# Exact pooled Version 12 AMOS specification reconstructed from supplied output.
# Keep original names to reproduce source; RiskPerception actually measures C9/C10 benefits.
# Fit with estimator="ML", missing="fiml", meanstructure=TRUE, fixed.x=FALSE,
# int.lv.free=FALSE, auto.cov.lv.x=FALSE, auto.cov.y=FALSE, likelihood="wishart".
# Use uncleaned SPSS Data.xlsx numerical inputs for a source-faithful comparison.

InstitutionalSupport =~ 1*B6 + B7
SafetyTraining =~ 1*B1 + B2 + B3
RiskPerception =~ 1*C9 + 1*C10
CommunityBehaviour =~ 1*C17 + 1*C19
SafetyPractices =~ 1*D1 + D2 + D3 + D4 + D5 + D6 + D7 + D8
SafetyCapability =~ 1*C11 + C12 + C13
Barriers =~ 1*C5 + C6 + C7 + C8
PesticideSymptoms =~ 1*E4 + E3 + E1 + E2
HeatProblems =~ 1*E10 + E11 + E12
MentalHealth =~ 1*E13 + E14 + E15

SafetyTraining ~ InstitutionalSupport
RiskPerception ~ InstitutionalSupport + SafetyTraining + Barriers
SafetyPractices ~ CommunityBehaviour + RiskPerception + A2 + A3 + A10 + A7 + A5 + A11 + A1 + A6 + A9 + A8 + A4
SafetyCapability ~ CommunityBehaviour + RiskPerception + A3 + A4 + A8 + A1 + A2 + A5 + A6 + A7 + A9 + A10 + A11
PesticideSymptoms ~ SafetyCapability + SafetyPractices + A10
HeatProblems ~ SafetyCapability + SafetyPractices
MentalHealth ~ SafetyCapability + SafetyPractices + PesticideSymptoms

# All 91 exogenous covariances freely estimated; otherwise identical to original.
InstitutionalSupport ~~ CommunityBehaviour + Barriers + A1 + A2 + A3 + A4 + A5 + A6 + A7 + A8 + A9 + A10 + A11
CommunityBehaviour ~~ Barriers + A1 + A2 + A3 + A4 + A5 + A6 + A7 + A8 + A9 + A10 + A11
Barriers ~~ A1 + A2 + A3 + A4 + A5 + A6 + A7 + A8 + A9 + A10 + A11
A1 ~~ A2 + A3 + A4 + A5 + A6 + A7 + A8 + A9 + A10 + A11
A2 ~~ A3 + A4 + A5 + A6 + A7 + A8 + A9 + A10 + A11
A3 ~~ A4 + A5 + A6 + A7 + A8 + A9 + A10 + A11
A4 ~~ A5 + A6 + A7 + A8 + A9 + A10 + A11
A5 ~~ A6 + A7 + A8 + A9 + A10 + A11
A6 ~~ A7 + A8 + A9 + A10 + A11
A7 ~~ A8 + A9 + A10 + A11
A8 ~~ A9 + A10 + A11
A9 ~~ A10 + A11
A10 ~~ A11

# Explicit zero residual covariances among the seven endogenous latent variables.
SafetyTraining ~~ 0*RiskPerception + 0*SafetyPractices + 0*SafetyCapability + 0*PesticideSymptoms + 0*HeatProblems + 0*MentalHealth
RiskPerception ~~ 0*SafetyPractices + 0*SafetyCapability + 0*PesticideSymptoms + 0*HeatProblems + 0*MentalHealth
SafetyPractices ~~ 0*SafetyCapability + 0*PesticideSymptoms + 0*HeatProblems + 0*MentalHealth
SafetyCapability ~~ 0*PesticideSymptoms + 0*HeatProblems + 0*MentalHealth
PesticideSymptoms ~~ 0*HeatProblems + 0*MentalHealth
HeatProblems ~~ 0*MentalHealth

# The AMOS model fixes all latent means/intercepts to zero.
InstitutionalSupport ~ 0*1
CommunityBehaviour ~ 0*1
Barriers ~ 0*1
SafetyTraining ~ 0*1
RiskPerception ~ 0*1
SafetyPractices ~ 0*1
SafetyCapability ~ 0*1
PesticideSymptoms ~ 0*1
HeatProblems ~ 0*1
MentalHealth ~ 0*1
